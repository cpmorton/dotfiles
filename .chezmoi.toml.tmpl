{{- /* Asked once per machine, then cached in ~/.config/chezmoi/chezmoi.toml.
       daily-driver-os applies this at login with nobody at the keyboard
       (--promptDefaults), so every question needs a default: the account's
       full name, and GitHub's no-reply address, which keeps a real address
       out of this public repository. */ -}}
{{- $fullName := .chezmoi.username -}}
{{- $gecos := index (output "getent" "passwd" .chezmoi.username | splitList ":") 4 | splitList "," | first | trim -}}
{{- if $gecos -}}
{{-   $fullName = $gecos -}}
{{- end -}}
{{- $name := promptStringOnce . "name" "Full name for git commits" $fullName -}}
{{- $email := promptStringOnce . "email" "Email for git commits" "7408774+cpmorton@users.noreply.github.com" -}}

[data]
    name = {{ $name | quote }}
    email = {{ $email | quote }}
    # Where secret values come from. Not decided yet, so nothing reads secrets.
    # Templates branch on this; wiring in a password manager later means
    # changing this line and the `if` blocks, not restructuring the repository.
    #   "none" | "bitwarden" | "onepassword"
    secrets = "none"
